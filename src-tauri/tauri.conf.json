{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notes & Goals",
  "mainBinaryName": "Notes & Goals",
  "version": "0.3.1",
  "identifier": "com.ashishjain.notesgoals",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Notes & Goals",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "copyright": "© 2026 Ashish Jain",
    "homepage": "https://ashishjain608.github.io/notes-goals-app/",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyM0YwMDVGRDA4Nzg4QUQKUldTdGlJZlFYd0Evc21XR1pTN1hpTWhnNmlGMHkzOUdrRWVKaG5vbXgyRDhJN284a05SU3Q2ZDcK",
      "endpoints": [
        "https://github.com/Ashishjain608/notes-goals-app/releases/latest/download/latest.json"
      ]
    }
  }
}
