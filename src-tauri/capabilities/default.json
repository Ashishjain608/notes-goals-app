{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core + dialog (incl. confirm) + opener (incl. reveal in Finder) permissions for the main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path",
    "dialog:allow-confirm",
    "opener:allow-reveal-item-in-dir"
  ]
}
